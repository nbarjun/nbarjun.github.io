<ul class="list-unstyled">
    <% for (const item of items) { %>
      <li class="mb-3">
        <strong><%= item.title %></strong><br>
        <em><%= item.venue %></em>, <%= item.location %> (<%= item.date ? item.date.substring(0, 4) : '' %>) 
        <% if (item.path) { %>
          [<a href="<%= item.path %>">Details</a>]
        <% } %>
      </li>
    <% } %>
    </ul>